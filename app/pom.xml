<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.uade.skillswap</groupId>
        <artifactId>skillswap-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app</artifactId>
    <name>SkillSwap - App</name>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions><execution><phase>package</phase><goals><goal>shade</goal></goals>
                    <configuration>
                        <createDependencyReducedPom>false</createDependencyReducedPom>
                        <filters><filter><artifact>*:*</artifact><excludes>
                            <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
                        </excludes></filter></filters>
                        <transformers>
                            <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                <mainClass>com.uade.skillswap.app.Main</mainClass>
                            </transformer>
                        </transformers>
                    </configuration>
                </execution></executions>
            </plugin>
        </plugins>
    </build>

    <!-- Presentación (Mock UI Kit) + punto de entrada que arma todo el grafo de objetos -->
    <dependencies>
        <dependency>
            <groupId>com.uade.skillswap</groupId>
            <artifactId>controllers</artifactId>
        </dependency>
        <dependency>
            <groupId>com.uade.skillswap</groupId>
            <artifactId>infrastructure</artifactId>
        </dependency>

        <!-- Tests de integración (controller -> caso de uso -> persistencia) contra H2 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
