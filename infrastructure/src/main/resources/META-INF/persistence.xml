<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="skillswapPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Listar acá cada entidad JPA a medida que se creen, por ejemplo:
        <class>com.uade.skillswap.infrastructure.persistence.PublicationJpaEntity</class>
        -->
        <class>com.uade.skillswap.infrastructure.persistence.booking.BookingJpaEntity</class>
        <class>com.uade.skillswap.infrastructure.persistence.booking.BookingTransitionJpaEntity</class>
        <class>com.uade.skillswap.infrastructure.persistence.publication.PublicationJpaEntity</class>
        <class>com.uade.skillswap.infrastructure.persistence.publication.PublicationSlotJpaEntity</class>
        <class>com.uade.skillswap.infrastructure.persistence.publication.PublicationTransitionJpaEntity</class>
        <class>com.uade.skillswap.infrastructure.persistence.profile.ProfileJpaEntity</class>
        <class>com.uade.skillswap.infrastructure.persistence.rating.RatingJpaEntity</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- El esquema lo maneja Flyway. Hibernate solo valida que las entidades coincidan con las tablas. -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
